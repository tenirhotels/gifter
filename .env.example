APP_NAME=Gifter
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

APP_TIMEZONE=Asia/Almaty

# Gifter
# GIFTER_NUMBER_STYLE: words (по умолчанию, непредсказуемый номер) или sequence (порядковый по шаблону ниже)
GIFTER_NUMBER_STYLE=words
GIFTER_NUMBER_PATTERN="{PREFIX}-{SEQ}"
GIFTER_NUMBER_PREFIX=GIF
GIFTER_NUMBER_PADDING=6
GIFTER_HOTEL_NAME=TENIR
GIFTER_HOTEL_CONTACTS="+7 700 000 00 00 · booking@example.com"

# Безопасность (docs/security.md). Значения — вымышленные, на сервере — свои случайные строки.
CONTACT_HASH_KEY=
BACKUP_ARCHIVE_PASSWORD=
BACKUP_MAIL_TO=
ERROR_MAIL_TO=
TRUSTED_PROXIES=
GIFTER_REQUIRE_PAYMENT_RECONCILED=true
GIFTER_REQUIRE_PRICE_APPROVAL=true
GIFTER_REVEAL_DAILY_LIMIT=30
# Только на время теста: GIFTER_REQUIRE_2FA=false (после теста вернуть true; страница «Безопасность» покажет ошибку)
# На рабочем сервере (docs/deploy-hoster-kz.md): APP_ENV=production, APP_DEBUG=false, LOG_LEVEL=warning,
# SESSION_LIFETIME=60, SESSION_EXPIRE_ON_CLOSE=true, SESSION_ENCRYPT=true, SESSION_SECURE_COOKIE=true

# Первый пользователь: php artisan gifter:create-user (пароль вводится интерактивно)

# Почта для уведомлений о новых онлайн-заявках с публичной страницы (без контактов клиента)
GIFTER_ORDERS_MAIL_TO=

# Оплата картой по ссылке (эквайринг банка). Ключи выдаёт банк; в репозиторий и чат не попадают.
# EPAY_ENV: test — тестовый терминал, prod — боевой. Пустые значения — функция выключена.
EPAY_ENV=test
EPAY_CLIENT_ID=
EPAY_CLIENT_SECRET=
EPAY_TERMINAL=
EPAY_SHOP_ID=
EPAY_EXPIRE_DAYS=3
