# Корень сайта (document root) должен указывать на папку public/.
# Если веб-сервер всё же смотрит в корень проекта — закрыть всё: .env, база, код и бэкапы не отдаются.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
